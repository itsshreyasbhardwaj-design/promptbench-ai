# ─────────────────────────────────────────────────────────────────────────────
# PromptBench AI — environment configuration
#
# Every variable below is OPTIONAL. With an empty .env the app runs in `local`
# mode: deterministic model responses, in-memory persistence, local identity.
# That is a fully functional product — no keys, no spend, no network.
#
# Add credentials only for the capabilities you actually want.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Renders the "demo data" banner and seeds an example workspace on boot.
NEXT_PUBLIC_DEMO_MODE=true

# ── Models (OpenRouter) ──────────────────────────────────────────────────────
# Set this to route real traffic to OpenAI / Anthropic / Gemini / Groq /
# DeepSeek / Mistral / Meta / Qwen / Cohere through a single gateway.
# Get a key at https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Force a driver regardless of the above. Useful for offline demos and CI.
# One of: local | openrouter
# PROMPTBENCH_DRIVER=local

# ── Database (Supabase / any Postgres) ───────────────────────────────────────
# Absent => repositories run in-memory (data resets on restart).
# DATABASE_URL=postgresql://postgres:password@localhost:5432/promptbench

# ── Auth (Clerk) ─────────────────────────────────────────────────────────────
# Absent => single local user, all routes accessible. Set both to enforce
# real multi-tenant auth and workspace membership.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...

# ── Limits ───────────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
MAX_MODELS_PER_RUN=8
MAX_DATASET_ROWS=1000
PROVIDER_TIMEOUT_MS=120000
